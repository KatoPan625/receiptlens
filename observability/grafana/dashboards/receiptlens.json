{
  "uid": "receiptlens",
  "title": "ReceiptLens",
  "tags": ["receiptlens"],
  "timezone": "Asia/Ho_Chi_Minh",
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "schemaVersion": 39,
  "panels": [
    {
      "id": 1, "type": "stat", "title": "API replicas up",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "count(up{job=\"api\"} == 1)" }]
    },
    {
      "id": 2, "type": "stat", "title": "Receipts uploaded (last 24 h)",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum(increase(http_requests_total{job=\"api\",route=\"/receipts\",method=\"POST\",status=\"201\"}[24h]))" }]
    },
    {
      "id": 3, "type": "stat", "title": "Dead-lettered messages",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum(rabbitmq_detailed_queue_messages{queue=~\".*\\\\.dead\"})" }],
      "fieldConfig": { "defaults": { "thresholds": { "mode": "absolute", "steps": [
        { "color": "green", "value": null }, { "color": "red", "value": 1 } ] } } }
    },
    {
      "id": 4, "type": "stat", "title": "Failed requests (5xx, last 1 h)",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum(increase(http_requests_total{job=\"api\",status=~\"5..\"}[1h])) or vector(0)" }]
    },
    {
      "id": 5, "type": "timeseries", "title": "Requests per second (HAProxy → API)",
      "gridPos": { "x": 0, "y": 5, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "targets": [{ "refId": "A", "expr": "sum(rate(haproxy_backend_http_requests_total{proxy=\"api\"}[1m]))", "legendFormat": "total" }]
    },
    {
      "id": 6, "type": "timeseries", "title": "API latency p95",
      "gridPos": { "x": 12, "y": 5, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [{ "refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"api\"}[1m])))", "legendFormat": "p95" }]
    },
    {
      "id": 7, "type": "timeseries", "title": "Queue depth (waiting messages)",
      "gridPos": { "x": 0, "y": 13, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "rabbitmq_detailed_queue_messages_ready{queue=~\"ocr\\\\.requests|api\\\\.results\"}", "legendFormat": "{{queue}}" }]
    },
    {
      "id": 8, "type": "timeseries", "title": "API replicas over time",
      "gridPos": { "x": 12, "y": 13, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "count(up{job=\"api\"} == 1)", "legendFormat": "replicas" }]
    }
  ]
}
