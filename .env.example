# Copy to .env with real random values. Easiest: run scripts/init-env.ps1, which generates them.
POSTGRES_USER=receiptlens
POSTGRES_PASSWORD=change-me
# Password of the least-privilege DB role api_rw used by the running API
API_DB_PASSWORD=change-me
RABBITMQ_USER=receiptlens
RABBITMQ_PASSWORD=change-me
# Least-privilege RabbitMQ users created by the migrate job
RABBITMQ_API_PASSWORD=change-me
RABBITMQ_OCR_PASSWORD=change-me
S3_ADMIN_KEY=change-me
S3_ADMIN_SECRET=change-me
S3_API_KEY=change-me
S3_API_SECRET=change-me
S3_OCR_KEY=change-me
S3_OCR_SECRET=change-me
# Grafana login (user: admin) at https://localhost/grafana/
GRAFANA_ADMIN_PASSWORD=change-me
