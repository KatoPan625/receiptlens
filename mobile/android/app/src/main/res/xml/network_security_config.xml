<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only. Release builds trust the system CAs only.
     Debug builds also trust CAs the user installed on the device, so the local mkcert CA
     (from `mkcert -CAROOT`) can be installed on a test phone or emulator to reach the dev server. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <debug-overrides>
        <trust-anchors>
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
