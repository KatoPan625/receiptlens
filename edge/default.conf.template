# Edge server for the owasp/modsecurity-crs nginx image (replaces its default server).
# ModSecurity + OWASP CRS is switched on for every request by the image's conf.d/modsecurity.conf.
# The image runs as an unprivileged user, so it listens on 8443; compose maps 443 -> 8443.

# The image already sets `resolver` from /etc/resolv.conf (Docker DNS, 127.0.0.11); using a
# variable in proxy_pass below makes nginx resolve per request, so it starts even before HAProxy.

# Rate limits (the "Cloud Armor" role together with the WAF).
# Uploads are limited much harder than reads. An empty key means "not limited by this zone".
map $request_method $upload_key {
    POST    $binary_remote_addr;
    default "";
}
limit_req_zone $binary_remote_addr zone=api:10m rate=100r/s;
limit_req_zone $upload_key         zone=upload:10m rate=2r/s;
limit_req_status 429;

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 8443 ssl;
    http2 on;
    server_name _;

    ssl_certificate     /etc/nginx/certs/edge.pem;
    ssl_certificate_key /etc/nginx/certs/edge-key.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    server_tokens off;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy no-referrer always;
    add_header Strict-Transport-Security "max-age=31536000" always;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Metrics are for Prometheus inside the app network only.
    location = /api/metrics {
        return 404;
    }

    location /api/ {
        limit_req zone=api burst=200 nodelay;
        limit_req zone=upload burst=10 nodelay;
        client_max_body_size 10m;          # matches the API's own limit
        set $lb http://lb:8080;
        rewrite ^/api/(.*)$ /$1 break;     # API routes have no /api prefix
        proxy_pass $lb;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 30s;
    }

    # Grafana has its own login. The WAF is off here only: CRS flags PromQL in Grafana's API calls
    # ({}, quotes, regex) as injection, which would break every dashboard panel.
    location /grafana/ {
        modsecurity off;
        limit_req zone=api burst=200 nodelay;
        set $grafana http://grafana:3000;
        proxy_pass $grafana;                # no URI part: forwards /grafana/... unchanged (serve_from_sub_path)
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_http_version 1.1;             # Grafana Live uses WebSockets
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }

    # Dashboard: static files only, strict Content-Security-Policy (no inline script, no third parties).
    # Repeating the security headers is required: an add_header here drops the server-level ones.
    location / {
        root /usr/share/nginx/html;
        index index.html;
        add_header Content-Security-Policy "default-src 'self'; img-src 'self' blob:; style-src 'self'; script-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'" always;
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options DENY always;
        add_header Referrer-Policy no-referrer always;
        add_header Strict-Transport-Security "max-age=31536000" always;
    }
}
